 347          
 348          void game_tick() {
 349   1          u8 i;
 350   1      
 351   1          /* Move obstáculos para a esquerda */
 352   1          for (i = 0; i < MAX_OBS; i++) {
 353   2              if (obs[i].active) {
 354   3                  if (obs[i].x <= 4) obs[i].active = 0;
 355   3                  else               obs[i].x -= 4;
 356   3              }
 357   2          }
 358   1      
 359   1          /* Move nuvem lentamente */
 360   1          if (cloud_x <= 1) cloud_x = 120;
 361   1          else              cloud_x -= 1;
 362   1      
 363   1          /* Spawna novo obstáculo quando o intervalo aleatório expira */
 364   1          frame_cnt++;
C51 COMPILER V9.60.7.0   REX_GLCD                                                          06/05/2026 22:25:26 PAGE 7   

 365   1          if (frame_cnt >= 18 + (my_rand() & 7)) {
 366   2              spawn_obstacle();
 367   2              frame_cnt = 0;
 368   2          }
 369   1      
 370   1          /* Controla duração do salto */
 371   1          if (dino_jump) {
 372   2              jump_phase++;
 373   2              if (jump_phase >= 8) { dino_jump = 0; jump_phase = 0; }
 374   2          }
 375   1      
 376   1          add_score();
 377   1      
 378   1          /* Alterna inversão de cor a cada 100 ticks */
 379   1          if (++phase_ctr >= 100) { phase = !phase; phase_ctr = 0; }
 380   1      
 381   1          /* Aumenta velocidade a cada 50 ticks (diminui tick_period) */
 382   1          if (++speed_ctr >= 50) {
 383   2              speed_ctr = 0;
 384   2              if (tick_period > 25) tick_period >>= 1;
 385   2          }
 386   1      
 387   1          if (check_collision()) game_over = 1;
 388   1          if (!game_over) draw_scene();
 389   1      }
 390          
 391          void game_init() {
 392   1          u8 i;
 393   1          for (i = 0; i < 5; i++) placar[i] = 0;
 394   1      
 395   1          tick_period = 100;
 396   1          speed_ctr   = 0;
 397   1          phase_ctr   = 0;
 398   1          dino_jump   = 0;
 399   1          jump_phase  = 0;
 400   1          game_over   = 0;
 401   1          frame_cnt   = 30;   /* começa próximo ao primeiro spawn */
 402   1          phase       = 0;
 403   1          cloud_x     = 100;
 404   1      
 405   1          for (i = 0; i < MAX_OBS; i++) obs[i].active = 0;
 406   1      }
 407          
 408          void main() {
 409   1          u16 t;
 410   1          char key;
 411   1      
 412   1          glcd_init();
 413   1          draw_start_screen();
 414   1      
 415   1          /* Aguarda tecla '2' para iniciar */
 416   1          while (1) {
 417   2              key = scanKeyNonBlock();
 418   2              if (key == '2') break;
 419   2          }
 420   1      
 421   1          game_init();
 422   1          draw_scene();
 423   1      
 424   1          while (1) {
 425   2              /* Reinicia após game over */
 426   2              if (game_over) {
C51 COMPILER V9.60.7.0   REX_GLCD                                                          06/05/2026 22:25:26 PAGE 8   

 427   3                  phase = 0;
 428   3                  draw_start_screen();
 429   3                  while (1) {
 430   4                      key = scanKeyNonBlock();
 431   4                      if (key == '2') { game_init(); draw_scene(); break; }
 432   4                  }
 433   3              }
 434   2      
 435   2              /* Loop de tick: varre teclado a cada 1 ms e executa o tick ao final */
 436   2              for (t = 0; t < tick_period; t++) {
 437   3                  key = scanKeyNonBlock();
 438   3                  if (key == '3') {           /* botão de salto */
 439   4                      if (!dino_jump) { dino_jump = 1; jump_phase = 0; }
 440   4                  }
 441   3                  delay_ms(1);
 442   3              }
 443   2      
 444   2              game_tick();
 445   2          }
 446   1      }


