 257          /* ============================================================
 258           * DETECÇÃO DE COLISÃO
 259           * ============================================================
 260           *
 261           * Caixa do dinossauro (hitbox com margem de 2px para
 262           * suavizar colisões nos cantos):
 263           *   x: [DINO_X+2 .. DINO_X+13]
 264           *   y: [dino_y+2 .. dino_y+13]
 265           *
 266           * Caixa dos obstáculos (16x16 com margem de 2px):
 267           *   x: [obs.x+2 .. obs.x+13]
 268           *   y: cacto ? [40+2 .. 40+13]
 269           *      pássaro ? [24+2 .. 24+13]
 270           */
 271          u8 check_collision() {
 272   1          u8 i;
 273   1          u8 dino_y;
 274   1          u8 dino_x1, dino_x2, dino_y1, dino_y2;
 275   1          u8 obs_x1,  obs_x2,  obs_y1,  obs_y2;
 276   1      
 277   1          dino_y = dino_jump ? JUMP_Y : DINO_Y;
 278   1      
 279   1          /* Hitbox do dinossauro com margem de 2px */
 280   1          dino_x1 = DINO_X + 2;
 281   1          dino_x2 = DINO_X + 13;
 282   1          dino_y1 = dino_y + 2;
 283   1          dino_y2 = dino_y + 13;
 284   1      
 285   1          for (i = 0; i < MAX_OBS; i++) {
 286   2              if (!obs[i].active) continue;
 287   2      
 288   2              /* Hitbox do obstáculo com margem de 2px */
 289   2              obs_x1 = obs[i].x + 2;
 290   2              obs_x2 = obs[i].x + 13;
 291   2      
 292   2              if (obs[i].type == 0) { /* cacto — no chão */
 293   3                  obs_y1 = 40 + 2;
 294   3                  obs_y2 = 40 + 13;
 295   3              } else {                /* pássaro — no ar */
 296   3                  obs_y1 = 24 + 2;
 297   3                  obs_y2 = 24 + 13;
 298   3              }
 299   2      
 300   2              /* AABB: colisão se os retângulos se sobrepõem nos dois eixos */
 301   2              if (dino_x1 <= obs_x2 && dino_x2 >= obs_x1 &&
 302   2                  dino_y1 <= obs_y2 && dino_y2 >= obs_y1) {
C51 COMPILER V9.60.7.0   REX_GLCD                                                          06/05/2026 22:25:26 PAGE 6   

 303   3                  return 1;
 304   3              }
 305   2          }
 306   1          return 0;
 307   1      }
