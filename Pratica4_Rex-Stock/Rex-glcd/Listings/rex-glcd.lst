 309          /* ============================================================
 310           * GERAÇÃO DE OBSTÁCULOS
 311           * ============================================================
 312           *
 313           * Ativa o primeiro slot livre do vetor obs[].
 314           * O tipo é sorteado: 0 = cacto, 1 = pássaro.
 315           * O obstáculo sempre nasce na borda direita (x = 120).
 316           */
 317          void spawn_obstacle() {
 318   1          u8 i;
 319   1          for (i = 0; i < MAX_OBS; i++) {
 320   2              if (!obs[i].active) {
 321   3                  obs[i].active = 1;
 322   3                  obs[i].x      = 120;
 323   3                  obs[i].type   = my_rand() & 1;  /* bit menos significativo: 0 ou 1 */
 324   3                  break;
 325   3              }
 326   2          }
 327   1      }
 328          
 329          /* ============================================================
 330           * ATUALIZAÇÃO DO PLACAR
 331           * ============================================================
 332           *
 333           * O placar é um contador de 5 dígitos decimais armazenado
 334           * em placar[0..4], onde placar[4] é a unidade.
 335           * Incrementa 1 ponto a cada chamada (1 tick = 1 ponto).
 336           */
 337          void add_score() {
 338   1          /* Incrementa unidade e propaga carry para dígitos superiores */
 339   1          placar[4]++;
 340   1          if (placar[4] > 9) { placar[4] = 0; placar[3]++; }
 341   1          if (placar[3] > 9) { placar[3] = 0; placar[2]++; }
 342   1          if (placar[2] > 9) { placar[2] = 0; placar[1]++; }
 343   1          if (placar[1] > 9) { placar[1] = 0; placar[0]++; }
 344   1          if (placar[0] > 9) {                placar[0] = 0; } /* overflow ? zera */
 345   1      }
