 123          void Draw_Sprite(unsigned char screen_y, unsigned char screen_x, unsigned char scroll_offset) {
 124   1          unsigned char gdram_y = (screen_y + scroll_offset) & 0x3F;
 125   1          
 126   1          // Carro esportivo (16x16)
 127   1          unsigned char code car_sprite[] = {
 128   1              0x00, 0x00,  // Linha 0
 129   1              0x07, 0xE0,  // Linha 1:    ******
 130   1              0x0F, 0xF0,  // Linha 2:   ********
 131   1              0x19, 0x98,  // Linha 3:  **  **  **
 132   1              0x10, 0x08,  // Linha 4:  *        *
 133   1              0x13, 0xC8,  // Linha 5:  *  ****  *
 134   1              0x1F, 0xF8,  // Linha 6:   **********
 135   1              0x1F, 0xF8,  // Linha 7:   **********
 136   1              0x1F, 0xF8,  // Linha 8:   **********
 137   1              0x0F, 0xF0,  // Linha 9:    ********
 138   1              0x09, 0x90,  // Linha 10:   *  *  *
 139   1              0x09, 0x90,  // Linha 11:   *  *  *
 140   1              0x09, 0x90,  // Linha 12:   *  *  *
 141   1              0x06, 0x60,  // Linha 13:    **  **
 142   1              0x00, 0x00,  // Linha 14
 143   1              0x00, 0x00   // Linha 15
 144   1          };
 145   1          
 146   1          unsigned char i;
 147   1          unsigned char byte_x;
 148   1          
 149   1          WriteCmdLcd(0x34);
 150   1          WriteCmdLcd(0x36);
 151   1          
 152   1          for(i = 0; i < 16; i++) {
 153   2              unsigned char current_y = (gdram_y + i) & 0x3F;
 154   2              
 155   2              // Desenha na metade esquerda (X=0-7)
 156   2              if(screen_x < 8) {
 157   3                  byte_x = screen_x;
 158   3                  WriteCmdLcd(0x80 | current_y);
 159   3                  WriteCmdLcd(0x80 | byte_x);
 160   3                  WriteDataLcd(car_sprite[i*2]);
 161   3                  WriteDataLcd(car_sprite[i*2 + 1]);
 162   3              }
 163   2              
 164   2              // Desenha na metade direita (X=8-15)
 165   2              if(screen_x >= 8) {
 166   3                  byte_x = screen_x & 0x07;  // Converte para 0-7
 167   3                  WriteCmdLcd(0x80 | current_y);
 168   3                  WriteCmdLcd(0x88 | byte_x);  // 0x88 = 8 (metade direita)
 169   3                  WriteDataLcd(car_sprite[i*2]);
 170   3                  WriteDataLcd(car_sprite[i*2 + 1]);
 171   3              }
 172   2          }
 173   1          
 174   1          WriteCmdLcd(0x30);
 175   1      }
