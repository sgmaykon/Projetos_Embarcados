 337          void Hybrid_Scroll_OscillatingEnemy(void) {
 338   1          unsigned char scroll_addr = 0;
 339   1          char enemy_direction = 1;  // 1 = descendo, -1 = subindo
 340   1          
 341   1          // Jogador fixo (direita)
 342   1          unsigned char player_y = 12, player_x = 10;
 343   1          
 344   1          // Inimigo oscilante (esquerda)
 345   1          unsigned char enemy_y = 0, enemy_x = 1;
 346   1          unsigned char enemy_prev_y = 0;
 347   1          
 348   1          WriteCmdLcd(0x34);
 349   1          WriteCmdLcd(0x36);
 350   1          WriteCmdLcd(0x03);
 351   1          
 352   1          Draw_Sprite(player_y, player_x, scroll_addr);
 353   1          Draw_Sprite(enemy_y, enemy_x, scroll_addr);
 354   1          
 355   1          while(1) {
 356   2              scroll_addr++;
 357   2              WriteCmdLcd(0x40 | scroll_addr);
 358   2              DelayUs(100);
 359   2              
 360   2              // Jogador fixo
 361   2              Clear_Sprite(player_y, player_x, (scroll_addr - 1) & 0x3F);
 362   2              Draw_Sprite(player_y, player_x, scroll_addr);
 363   2              
 364   2              // Inimigo oscilante
C51 COMPILER V9.60.7.0   STOCK                                                             05/21/2026 21:25:19 PAGE 7   

 365   2              enemy_prev_y = enemy_y;
 366   2              
 367   2              if(enemy_direction == 1) {  // Descendo
 368   3                  enemy_y++;
 369   3                  if(enemy_y >= 28) {  // Não deixa sair totalmente
 370   4                      enemy_direction = -1;  // Começa subir
 371   4                  }
 372   3              } else {  // Subindo
 373   3                  enemy_y--;
 374   3                  if(enemy_y == 0) {
 375   4                      enemy_direction = 1;  // Começa descer
 376   4                  }
 377   3              }
 378   2              
 379   2              Clear_Sprite(enemy_prev_y, enemy_x, scroll_addr);
 380   2              Draw_Sprite(enemy_y, enemy_x, scroll_addr);
 381   2              
 382   2              DelayMs(80);
 383   2          }
 384   1      }
