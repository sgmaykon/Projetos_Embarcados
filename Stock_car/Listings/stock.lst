 179          // ==========================================================
 180          void Clear_Sprite(unsigned char screen_y, unsigned char screen_x, unsigned char scroll_offset) {
 181   1          unsigned char gdram_y = (screen_y + scroll_offset) & 0x3F;
 182   1          unsigned char i, byte_x;
 183   1          
 184   1          WriteCmdLcd(0x34);
 185   1          WriteCmdLcd(0x36);
 186   1          
 187   1          for(i = 0; i < 16; i++) {
 188   2              unsigned char current_y = (gdram_y + i) & 0x3F;
 189   2              unsigned char dash_pattern = ((current_y % 8) < 4) ? 0xFF : 0x00;
 190   2              
 191   2              // Metade esquerda
 192   2              if(screen_x < 8) {
 193   3                  byte_x = screen_x;
 194   3                  WriteCmdLcd(0x80 | current_y);
 195   3                  WriteCmdLcd(0x80 | byte_x);
 196   3                  
 197   3                  // Redesenha a pista normal
 198   3                  if(byte_x == 0) {
 199   4                      WriteDataLcd(0xFF); WriteDataLcd(0x00);  // Borda
 200   4                  } else if(byte_x >= 3 && byte_x <= 4) {
 201   4                      WriteDataLcd(dash_pattern); WriteDataLcd(dash_pattern);  // Tracejado
 202   4                  } else {
 203   4                      WriteDataLcd(0x00); WriteDataLcd(0x00);  // Vazio
 204   4                  }
 205   3              }
 206   2              
 207   2              // Metade direita
 208   2              if(screen_x >= 8) {
 209   3                  byte_x = screen_x & 0x07;
 210   3                  WriteCmdLcd(0x80 | current_y);
 211   3                  WriteCmdLcd(0x88 | byte_x);
 212   3                  
 213   3                  if(byte_x == 0) {
 214   4                      WriteDataLcd(0xFF); WriteDataLcd(0x00);  // Borda
 215   4                  } else if(byte_x >= 3 && byte_x <= 4) {
 216   4                      WriteDataLcd(dash_pattern); WriteDataLcd(dash_pattern);  // Tracejado
 217   4                  } else {
 218   4                      WriteDataLcd(0x00); WriteDataLcd(0x00);  // Vazio
 219   4                  }
 220   3              }
 221   2          }
 222   1          
 223   1          WriteCmdLcd(0x30);
 224   1      }
