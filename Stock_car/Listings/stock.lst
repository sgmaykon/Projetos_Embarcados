 285          void Hybrid_Scroll_VariableSpeed(void) {
 286   1          unsigned char scroll_addr = 0;
 287   1          unsigned char frame_count = 0;
 288   1          
 289   1          // Jogador fixo (direita)
 290   1          unsigned char player_y = 12, player_x = 10;
 291   1          
 292   1          // Inimigo móvel (esquerda)
 293   1          unsigned char enemy_y = 0, enemy_x = 1;
 294   1          unsigned char enemy_prev_y = 0;
 295   1          unsigned char enemy_speed = 2;  // Move a cada 2 frames
 296   1          
 297   1          WriteCmdLcd(0x34);
 298   1          WriteCmdLcd(0x36);
 299   1          WriteCmdLcd(0x03);
 300   1          
 301   1          Draw_Sprite(player_y, player_x, scroll_addr);
