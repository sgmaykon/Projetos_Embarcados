 227          // SCROLL HÍBRIDO COM DOIS SPRITES
 228          // ==========================================================
 229          void Hybrid_Scroll_Two_Sprites(void) {
 230   1          unsigned char scroll_addr = 0;
 231   1          unsigned char enemy_y = 0;  // Inimigo começa no topo
 232   1          
 233   1          // Jogador: FIXO na tela (lado direito, meio)
 234   1          unsigned char player_screen_y = 12;   // Posição Y fixa na tela
 235   1          unsigned char player_screen_x = 10;   // Lado direito (X=10)
 236   1          
 237   1          // Inimigo: MÓVEL descendo (lado esquerdo)
 238   1          unsigned char enemy_screen_x = 1;     // Lado esquerdo (X=1)
 239   1          unsigned char enemy_screen_y = 0;     // Posição Y atual na tela
 240   1          unsigned char enemy_prev_y = 0;       // Posição Y anterior
C51 COMPILER V9.60.7.0   STOCK                                                             05/21/2026 21:25:19 PAGE 5   

 241   1          
 242   1          WriteCmdLcd(0x34);
 243   1          WriteCmdLcd(0x36);
 244   1          WriteCmdLcd(0x03);  // Habilita scroll
 245   1          
 246   1          // Desenha sprites iniciais
 247   1          Draw_Sprite(player_screen_y, player_screen_x, scroll_addr);
 248   1          Draw_Sprite(enemy_screen_y, enemy_screen_x, scroll_addr);
 249   1          
 250   1          while(1) {
 251   2              // PASSO 1: Scroll (instantâneo)
 252   2              scroll_addr++;
 253   2              WriteCmdLcd(0x40 | scroll_addr);
 254   2              
 255   2              // PASSO 2: Pequena pausa para estabilizar
 256   2              DelayUs(100);
 257   2              
 258   2              // PASSO 3: Jogador FIXO - Limpa e redesenha na mesma posição
 259   2              Clear_Sprite(player_screen_y, player_screen_x, (scroll_addr - 1) & 0x3F);
 260   2              Draw_Sprite(player_screen_y, player_screen_x, scroll_addr);
 261   2              
 262   2              // PASSO 4: Inimigo MÓVEL - Desce um pixel
 263   2              enemy_prev_y = enemy_screen_y;
 264   2              enemy_screen_y++;
 265   2              
 266   2              // Se inimigo saiu da tela, volta ao topo
 267   2              if(enemy_screen_y >= 32) {
 268   3                  enemy_screen_y = 0;
 269   3              }
 270   2              
 271   2              // Limpa inimigo na posição antiga
 272   2              Clear_Sprite(enemy_prev_y, enemy_screen_x, scroll_addr);
 273   2              
 274   2              // Desenha inimigo na nova posição
 275   2              Draw_Sprite(enemy_screen_y, enemy_screen_x, scroll_addr);
 276   2              
 277   2              // PASSO 5: Delay para controle de velocidade
 278   2              DelayMs(80);  // Velocidade do jogo (scroll + movimento inimigo)
 279   2          }
 280   1      }
