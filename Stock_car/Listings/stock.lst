C51 COMPILER V9.60.7.0   STOCK                                                             05/21/2026 21:25:19 PAGE 6   

 303   1          
 304   1          while(1) {
 305   2              // Scroll sempre acontece
 306   2              scroll_addr++;
 307   2              WriteCmdLcd(0x40 | scroll_addr);
 308   2              DelayUs(100);
 309   2              
 310   2              // Jogador fixo - sempre redesenha
 311   2              Clear_Sprite(player_y, player_x, (scroll_addr - 1) & 0x3F);
 312   2              Draw_Sprite(player_y, player_x, scroll_addr);
 313   2              
 314   2              // Inimigo move a cada 'enemy_speed' frames
 315   2              if((frame_count % enemy_speed) == 0) {
 316   3                  enemy_prev_y = enemy_y;
 317   3                  enemy_y++;
 318   3                  
 319   3                  if(enemy_y >= 32) {
 320   4                      enemy_y = 0;
 321   4                  }
 322   3                  
 323   3                  Clear_Sprite(enemy_prev_y, enemy_x, scroll_addr);
 324   3              }
 325   2              
 326   2              // Sempre redesenha inimigo na posição atual
 327   2              Draw_Sprite(enemy_y, enemy_x, scroll_addr);
 328   2              
 329   2              frame_count++;
 330   2              DelayMs(50);
 331   2          }
 332   1      }
